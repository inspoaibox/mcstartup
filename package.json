{
  "name": "mcstartup",
  "version": "0.1.0",
  "description": "A modern Windows quick launcher tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tauri.ps1",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tauri.ps1 dev",
    "tauri:build": "tauri build",
    "build:shell-extension:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-shell-extension.ps1 -Profile debug",
    "build:shell-extension:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-shell-extension.ps1 -Profile release",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@assistant-ui/react": "^0.12.25",
    "@assistant-ui/react-ui": "^0.2.1",
    "@huggingface/transformers": "^4.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^1.5.3",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.168",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "cssnano": "^7.1.5",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.344.0",
    "lunar-javascript": "^1.7.7",
    "monaco-editor": "^0.55.1",
    "opencc-js": "^1.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "pinyin-pro": "^3.28.1",
    "postcss-preset-env": "^11.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "simple-mind-map": "^0.14.0-fix.2",
    "sql-formatter": "^15.7.3",
    "tldraw": "^5.0.0",
    "vditor": "^3.11.2",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^1.5.9",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}
